{
  "expo": {
    "name": "Majane",
    "slug": "majane",
    "privacy": "unlisted",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/new/icon-majane.png",
    "splash": {
      "image": "./assets/new/splash-majane.png",
      "resizeMode": "cover",
      "backgroundColor": "#b73070"
    },
    "updates": {
      "fallbackToCacheTimeout": 0,
      "url": "https://u.expo.dev/62ed3a93-0871-4a94-b0dc-299feabcd2f5"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "buildNumber": "1",
      "bundleIdentifier": "com.hasnawi.majane",
      "supportsTablet": true,
      "requireFullScreen": true
    },
    "android": {
      "versionCode": 1,
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyDwyKdigGg0_3Xy3ZDZYrLW7w7bisUiQyo"
        }
      },
      "adaptiveIcon": {
        "foregroundImage": "./assets/new/adaptive-icon.png",
        "backgroundColor": "#b73070"
      },
      "package": "com.hasnawi.majane",
      "permissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.READ_INTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static"
          }
        }
      ],
      [
        "onesignal-expo-plugin",
        {
          "mode": "production"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "The app accesses your photos to let you share them with your friends."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "f08e2690-b7cc-11e9-85c0-75b37395c941",
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "targetName": "OneSignalNotificationServiceExtension",
                  "bundleIdentifier": "com.hasnawi.majane.OneSignalNotificationServiceExtension",
                  "entitlements": {
                    "com.apple.security.application-groups": [
                      "group.com.hasnawi.majane.onesignal"
                    ]
                  }
                }
              ]
            }
          }
        }
      }
    },
    "runtimeVersion": {
      "policy": "sdkVersion"
    },
    "owner": "wicombit"
  }
}